#include <stdio.h>
#include <string.h>

struct Employee {
    int id;
    char name[51];
    float salary;
};

int main() {
    int n;
    scanf("%d", &n);
    
    struct Employee employees[n];
    for (int i = 0; i < n; i++) {
        scanf("%d %50s %f", &employees[i].id, employees[i].name, &employees[i].salary);
    }
    
    struct Employee highest = employees[0];
    for (int i = 1; i < n; i++) {
        if (employees[i].salary > highest.salary) {
            highest = employees[i];
        }
    }
    
    printf("%d %s %.2f\n", highest.id, highest.name, highest.salary);
    return 0;
}
