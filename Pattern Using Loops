#include <stdio.h>

// helper function to limit the result to a given bound
int clamp(int num, int min) {
    if(num>min) {
        return num;
    }
    return min;
}

int main() {
    int n, m;
    scanf("%d", &n);
    m=2*n-1;
    int buffer[m], stack[n+1][m], lhs, rhs;
        // first half + middle row
    for(int lower_bound=n; lower_bound>=1; lower_bound--) {
                // use two pointers to make only half of the calculations
        lhs=0;
        rhs=m-1;
        for(int i=0; i<n-1; i++) {
            int res=clamp(n-i, lower_bound);
            buffer[lhs++]=res;
            buffer[rhs--]=res;
        }
        buffer[n-1]=lower_bound;
        for(int i=0; i<m; i++) {
            printf("%d ", buffer[i]);
            stack[lower_bound][i]=buffer[i];
        }
        printf("\n");
    }
    // second half with memoization (dynamic programming)
    for(int i=2; i<n+1; i++) {
        for(int j=0; j<m; j++) {
            printf("%d ", stack[i][j]);
        }
        printf("\n");
    }

    return 0;
}
